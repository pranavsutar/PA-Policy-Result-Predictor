# ── LLM Provider ─────────────────────────────────────────────────────
# "groq-8b-focused" (default) or "groq-70b-focused"
LLM_PROVIDER=groq-8b-focused

# ── Groq ─────────────────────────────────────────────────────────────
# Sign up at console.groq.com, generate API key(s)
# Comma-separated for key rotation (rate-limit resilience)
GROQ_API_KEYS=your-groq-key-here

# Models (defaults shown — override if needed)
# GROQ_EXTRACTION_MODEL=llama-3.3-70b-versatile
# GROQ_VALIDATION_MODEL=llama-3.1-8b-instant

# ── Shared ───────────────────────────────────────────────────────────
# Spacing between API calls in seconds (default: 1)
# CALL_SPACING=1

# Context filter level: page, paragraph, or sentence (default: sentence)
# FILTER_LEVEL=sentence
