# Keep cache/ and output/ — they contain pre-computed results for deployment.
# After running the full pipeline locally, commit cache/ so the deployed
# Streamlit app can display results without re-running extractions.
# (Streamlit Cloud has ephemeral storage — files written at runtime are
# lost on restart.)

# Data — PDFs are large; commit only if deploying with full dataset
ads_extracted/

